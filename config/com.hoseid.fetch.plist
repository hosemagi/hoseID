<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hoseid.fetch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/hosebot/projects/hoseid/.venv-fetch/bin/python</string>
        <string>-m</string>
        <string>fetchers.daemon</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/hosebot/projects/hoseid</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>/Users/hosebot/logs/hoseid-fetch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hosebot/logs/hoseid-fetch.log</string>
</dict>
</plist>
