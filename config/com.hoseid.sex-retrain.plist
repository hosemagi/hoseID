<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hoseid.sex-retrain</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/hosebot/projects/hoseid/training/sex/retrain.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/hosebot/projects/hoseid</string>
    <key>UserName</key>
    <string>hosebot</string>
    <key>GroupName</key>
    <string>staff</string>
    <key>InitGroups</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/hosebot</string>
        <key>USER</key>
        <string>hosebot</string>
        <key>LOGNAME</key>
        <string>hosebot</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/hosebot/logs/hoseid-sex-retrain.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hosebot/logs/hoseid-sex-retrain.log</string>
</dict>
</plist>
