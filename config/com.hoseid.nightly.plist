<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hoseid.nightly</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/hosebot/projects/hoseid/scripts/nightly.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/hosebot/logs/hoseid-nightly.log</string>
	<key>StandardOutPath</key>
	<string>/Users/hosebot/logs/hoseid-nightly.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>2</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/hosebot/projects/hoseid</string>
</dict>
</plist>
